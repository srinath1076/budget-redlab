# RedLab Cloud secrets — copy to .env (which is gitignored) and fill in.
# Get these from the RunPod console after following docs/RUNPOD_RUNBOOK.md.

# Account API key: Settings -> API Keys -> + Create (read/write — needed to create/
# terminate pods). Used for pod lifecycle, the balance/cost check, and serverless auth.
# This is the ONLY value you must fill in by hand.
RUNPOD_API_KEY=

# --- Inference target: normally AUTO-MANAGED, don't hand-edit ---

# (A) POD (recommended, scripted): `./redlab-pod.sh up` creates the pod and WRITES both
# REDLAB_BASE_URL and REDLAB_POD_ID below for you; `./redlab-pod.sh down` clears them.
# Only set REDLAB_BASE_URL by hand if you deployed a pod manually in the console
# (format: https://<POD_ID>-30000.proxy.runpod.net/v1).
REDLAB_BASE_URL=
# REDLAB_POD_ID=          # written by redlab-pod.sh up; the pod handle for down/status

# Bearer key the vLLM server requires (passed to the pod as VLLM_API_KEY). Normally
# AUTO-GENERATED by `./redlab-pod.sh up` and written here for you — leave blank to let it
# mint one. Set it by hand only to pin a specific key. Delete this line + re-run `up` to rotate.
# REDLAB_INFERENCE_KEY=

# (B) SERVERLESS (alternative): the endpoint id (leave REDLAB_BASE_URL blank if you use this).
# Serverless -> your endpoint -> the id in its URL/card.
RUNPOD_ENDPOINT_ID=

# HuggingFace token. OPTIONAL for public weights (only silences a rate-limit warning and
# speeds downloads); REQUIRED if REDLAB_MODEL is a gated or private repo. `redlab-pod.sh up`
# injects it into the pod as HF_TOKEN. Get one at huggingface.co/settings/tokens (read scope).
# REDLAB_HF_TOKEN=

# --- Optional overrides (sensible defaults are set by redlabLLM.sh) ---
# The HuggingFace model id you deployed on the endpoint. Default is the 4-bit AWQ that
# fits a 48GB A40 (~45.9GB). FP8 is ~80GB and needs an 80GB card — do not use it here.
# REDLAB_MODEL=cyankiwi/Qwen3-Next-80B-A3B-Instruct-AWQ-4bit

# REDLAB_SYSTEM_PROMPT=prompts/ethical-hacker.cloud.system.md
# REDLAB_TEMP=0.6
# REDLAB_TOP_P=0.95
# REDLAB_MAX_TOKENS=4096
# REDLAB_TIMEOUT=600
